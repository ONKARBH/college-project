.civil-dept {
  padding: 40px 8%;
  background: #f8fafc;
  color: #1e293b;
  font-family: "Segoe UI", sans-serif;
}

/* Top Row: Image Left + First Paragraph Right */
.civil-top-row {
  display: flex;
  align-items: flex-start;
  gap: 30px;
  margin-bottom: 30px;

  .civil-image {
    flex: 0 0 300px; 
    img {
      width: 100%;
      height: auto;
      border-radius: 10px;
      object-fit: cover;
    }
  }

  .civil-intro-right {
    flex: 1;

    h1 {
      font-size: 2rem;
      color: #1a365d;
      margin-bottom: 15px;
    }

    p {
      line-height: 1.7;
      margin-bottom: 12px;
    }
  }
}

/* Remaining content below full width */
.civil-below {
  p {
    line-height: 1.7;
    margin-bottom: 12px;
  }
}

/* Highlight Section (if needed) */
.highlight {
  background: linear-gradient(135deg, #e0ecff, #ffffff);
  padding: 25px;
  border-radius: 14px;
  margin-bottom: 30px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
}

/* Vision & Mission Boxes */
.civil-vm {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 25px;
  margin-top: 30px;

  .box {
    background: #1a365d;
    color: #ffffff;
    padding: 25px;
    border-radius: 16px;

    h2 {
      margin-bottom: 12px;
      color: #ffd166;
    }

    p, ul {
      line-height: 1.7;
    }

    ul {
      padding-left: 18px;

      li {
        margin-bottom: 8px;
      }
    }
  }
}

/* Features list */
.features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 12px;
  margin-top: 15px;

  li {
    background: #e6f0ff;
    padding: 12px 15px;
    border-radius: 10px;
    font-weight: 500;
  }
}

/* Responsive */
@media (max-width: 768px) {
  .civil-top-row {
    flex-direction: column;

    .civil-image {
      flex: 1 1 100%;
      margin-bottom: 20px;
    }
  }

  .civil-intro-right h1 {
    font-size: 1.8rem;
  }
}
